{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "types": ["react", "react-native"],
    "paths": {
      "@/*": ["./*"],
      "react-native": ["../../node_modules/react-native"]
    },
    "plugins": [
      {
        "name": "react-compiler",
        "disabled": true
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"],
  "extends": "expo/tsconfig.base"
}
